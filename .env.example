# Backend and frontend both read this file. The backend loads it through dotenvy; the frontend
# through SvelteKit's kit.env.dir, pointed here from web/svelte.config.ts.

# Required

DATABASE_URL=postgresql://banner:banner@localhost:59489/banner
BOT_TOKEN=
BOT_TARGET_GUILD=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: server

# Seeds this Discord user as an admin on startup, and enables the debug-build auth bypass.
ADMIN_DISCORD_ID=
# Web listener, and the Prometheus exposition listener.
PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
# Fixes the OAuth redirect URI; derived from the request's Origin/Host when unset.
DISCORD_REDIRECT_URI=
# Absolute URLs in sitemaps. Sitemap endpoints 404 when unset.
PUBLIC_ORIGIN=
# Upstream Banner instance. Defaults to UTSA's production host.
BANNER_BASE_URL=

# Optional: frontend

# Where the SSR server reaches the Rust API.
BACKEND_URL=http://localhost:8080
# Emit SSR console output as JSON rather than the human-readable formatter.
LOG_JSON=
# PostHog analytics. Telemetry is disabled when unset.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=
# Source map upload at build time only.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Optional: deployment (consumed by tempo, never by the application)

DEPLOY_HOST=
DEPLOY_PATH=~/banner-src
DEPLOY_IMAGE=ghcr.io/xevion/banner
DEPLOY_RELEASE=banner
