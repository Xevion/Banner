  "query": "\n        SELECT ci.course_id, i.display_name\n        FROM course_instructors ci\n        JOIN instructors i ON i.id = ci.instructor_id\n        WHERE ci.course_id = ANY($1)\n        ORDER BY ci.course_id, ci.is_primary DESC, i.display_name\n        ",
