{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT ci.instructor_id, c.subject, COUNT(*) AS \"count!\"\n        FROM course_instructors ci\n        JOIN courses c ON c.id = ci.course_id\n        WHERE ci.instructor_id = ANY($1)\n        GROUP BY ci.instructor_id, c.subject\n        ",
