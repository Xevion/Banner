  "query": "\n        INSERT INTO users (discord_id, discord_username, is_admin)\n        VALUES ($1, 'seed-admin', true)\n        ON CONFLICT (discord_id) DO UPDATE\n            SET is_admin = true,\n                updated_at = now()\n        RETURNING discord_id, discord_username, discord_avatar_hash, is_admin, created_at, updated_at\n        ",
