{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            cw.watch_type AS \"watch_type: WatchType\",\n            cw.notified_at,\n            c.crn,\n            c.term_code,\n            c.subject,\n            c.course_number,\n            c.title\n        FROM course_watches cw\n        JOIN courses c ON c.id = cw.course_id\n        WHERE cw.discord_user_id = $1\n          AND cw.active = TRUE\n        ORDER BY c.subject, c.course_number, c.crn, cw.watch_type\n        ",
